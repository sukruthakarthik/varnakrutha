# ─── Site ────────────────────────────────────────────────────────────
# Public base URL (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slug of the artist whose portfolio is served at the site root.
NEXT_PUBLIC_DEFAULT_ARTIST_SLUG=sukrutha

# Optional contact details shown on the Contact page and footer (hidden when empty).
# Use an address you actually receive mail at.
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only (e.g. 919876543210).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Data source ─────────────────────────────────────────────────────
# "mock"     -> local JSON store in .data/ (seeded from src/data/seed.ts)
# "supabase" -> Supabase Postgres + Storage + Auth
NEXT_PUBLIC_DATA_SOURCE=mock

# ─── Admin (mock mode only) ──────────────────────────────────────────
# Password for /admin while running on mock data.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string (32+ chars) used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-64-hex-characters

# ─── Supabase (supabase mode) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC_: bypasses Row Level Security. Used only when an admin accepts an
# artist application, to create the artist's login and email them an invitation.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payments (see docs/PAYMENTS.md) ─────────────────────────────────
# The toggle:
#   off      -> no buying online; enquiries only (default)
#   manual   -> "Buy now" / "Reserve" with UPI (PhonePe, Google Pay…) to NEXT_PUBLIC_UPI_ID;
#               an admin confirms each payment in Admin -> Orders
#   razorpay -> Razorpay checkout; featured artists' shares split via Route where set up
# Run supabase/migrations/20261029000000_orders_and_payments.sql before turning it on.
NEXT_PUBLIC_PAYMENTS_MODE=off

# Commission on featured artists' sales, in basis points (1500 = 15%). Per-artist overrides:
# artists.commission_rate_bps in the Supabase Table Editor. The site's own artist pays none.
COMMISSION_RATE_BPS=1500

# Manual mode: your merchant UPI ID (PhonePe Business / Google Pay for Business), the name buyers
# see, and optionally a QR image saved in /public (e.g. /payments/upi-qr.png).
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME=Varnakrutha
NEXT_PUBLIC_UPI_QR_IMAGE=

# Razorpay mode (Dashboard -> Account & Settings -> API Keys; use test keys first).
# The webhook secret is the one you type when adding the webhook (Dashboard -> Webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Lab (Admin -> Lab) ──────────────────────────────────────────────
# Optional: signs the 2-hour viewer links for Lab files. If unset, SUPABASE_SERVICE_ROLE_KEY
# (or ADMIN_SESSION_SECRET in mock mode) is used. 32+ random characters.
LAB_LINK_SECRET=

# ─── Cron (production) ───────────────────────────────────────────────
# Random secret that protects /api/keep-alive. Vercel Cron sends it automatically.
CRON_SECRET=
