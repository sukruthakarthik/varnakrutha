# ─── Site ────────────────────────────────────────────────────────────
# Public base URL (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slug of the artist whose portfolio is served at the site root.
NEXT_PUBLIC_DEFAULT_ARTIST_SLUG=sukrutha

# Optional contact details shown on the Contact page and footer (hidden when empty).
# Use an address you actually receive mail at.
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only (e.g. 919876543210).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Data source ─────────────────────────────────────────────────────
# "mock"     -> local JSON store in .data/ (seeded from src/data/seed.ts)
# "supabase" -> Supabase Postgres + Storage + Auth
NEXT_PUBLIC_DATA_SOURCE=mock

# ─── Admin (mock mode only) ──────────────────────────────────────────
# Password for /admin while running on mock data.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string (32+ chars) used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-64-hex-characters

# ─── Supabase (supabase mode) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Cron (production) ───────────────────────────────────────────────
# Random secret that protects /api/keep-alive. Vercel Cron sends it automatically.
CRON_SECRET=
